{
  "name": "agent-skill-lint",
  "version": "0.1.0",
  "description": "Lint agent SKILL.md files for broken references, colliding triggers, unroutable descriptions and context bloat.",
  "type": "module",
  "bin": {
    "agent-skill-lint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:self": "node dist/cli.js .",
    "build:demo": "node scripts/sync-examples.mjs && tsc -p tsconfig.demo.json",
    "e2e": "playwright test"
  },
  "keywords": [
    "agent",
    "skills",
    "claude",
    "lint",
    "SKILL.md",
    "ai-agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  }
}
